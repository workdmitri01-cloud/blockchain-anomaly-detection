# --- Бот №1: командные кошельки ---
TEAM_BOT_TOKEN=
TEAM_CHAT_ID=

# --- Бот №2: заводы/выводы на биржи ---
EXCHANGE_BOT_TOKEN=
EXCHANGE_CHAT_ID=

# --- Бот №3: выводы с бирж на фреш-кошельки ---
FRESH_BOT_TOKEN=
FRESH_CHAT_ID=

# --- Свои RPC (необязательно; без них используются бесплатные публичные) ---
# Alchemy:  https://eth-mainnet.g.alchemy.com/v2/<KEY>
# Infura:   https://mainnet.infura.io/v3/<KEY>
ETH_RPC_URL=
# Свой Gnosis RPC (необязательно; без него — публичные rpc.gnosischain.com / publicnode / drpc)
GNOSIS_RPC_URL=

# Etherscan V2 (https://etherscan.io/apis). Необязателен: автопоиск работает через
# Blockscout без ключа. Бесплатный тариф НЕ покрывает BSC/Base/OP/Avalanche.
ETHERSCAN_API_KEY=

# NodeReal MegaNode (https://nodereal.io/meganode) — бесплатный ключ, нужен для
# автопоиска командных кошельков на BSC (данные BSCTrace).
NODEREAL_API_KEY=

# CoinGecko demo key (необязательно, только резервный источник цен)
COINGECKO_API_KEY=

# --- Tron / Solana / Hyperliquid (всё необязательно) ---
# TronGrid (https://www.trongrid.io) — бесплатный ключ, без него работает с более жёсткими лимитами
TRONGRID_API_KEY=
# Свой Solana RPC (Helius / QuickNode free tier) — подставьте в chains.solana.rpc_urls конфига бота
SOLANA_RPC_URL=
