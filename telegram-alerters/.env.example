# --- Бот №1: командные кошельки ---
TEAM_BOT_TOKEN=
TEAM_CHAT_ID=

# --- Бот №2: заводы/выводы на биржи ---
EXCHANGE_BOT_TOKEN=
EXCHANGE_CHAT_ID=

# --- Свои RPC (необязательно; без них используются бесплатные публичные) ---
# Alchemy:  https://eth-mainnet.g.alchemy.com/v2/<KEY>
# Infura:   https://mainnet.infura.io/v3/<KEY>
ETH_RPC_URL=

# Etherscan V2 (https://etherscan.io/apis). Необязателен: автопоиск работает через
# Blockscout без ключа. Бесплатный тариф НЕ покрывает BSC/Base/OP/Avalanche.
ETHERSCAN_API_KEY=

# NodeReal MegaNode (https://nodereal.io/meganode) — бесплатный ключ, нужен для
# автопоиска командных кошельков на BSC (данные BSCTrace).
NODEREAL_API_KEY=

# CoinGecko demo key (необязательно, только резервный источник цен)
COINGECKO_API_KEY=
